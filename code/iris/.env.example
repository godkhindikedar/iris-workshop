# ===================================================
#  YOU FILL THESE IN
# ===================================================

# Active domain: reddash | electrohub | finance-researcher | healthcare | radish-bank | rmobile
DEMO_DOMAIN=reddash

# Gemini on Google Cloud (Vertex AI), the agent's model. Full steps: docs/setup/setup.md.
# Set your Google Cloud project ID, then run `make gcp-login` in the Terminal panel and sign in with a
# Google account that has the "Agent Platform User" role (roles/aiplatform.user) on that project.
# The sign-in is stored at the default GOOGLE_APPLICATION_CREDENTIALS path below.
# Or use a service account key: save it as secrets/gcp-key.json and set
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-key.json.
GOOGLE_CLOUD_PROJECT=

# Redis Cloud database
REDIS_HOST=kindhearted-screw-juniper-35305.db.redis.io
REDIS_PORT=13709
REDIS_PASSWORD=
REDIS_SSL=false

# Context Surfaces (admin key from cloud console)
CTX_ADMIN_KEY=

# Agent Memory
MEMORY_API_BASE_URL=
MEMORY_STORE_ID=
MEMORY_API_KEY=

# LangCache
LANGCACHE_HOST=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=

# ===================================================
#  AUTO-POPULATED (by make setup)
# ===================================================

MCP_AGENT_KEY=
CTX_SURFACE_ID=
DEMO_USER_ID=
DEMO_USER_NAME=
DEMO_USER_EMAIL=

# ===================================================
#  DEFAULTS (change only if needed)
# ===================================================

# "global" lets Google pick the region; use a region such as us-central1 if your quota is regional.
GOOGLE_CLOUD_LOCATION=global
# Where the Google sign-in (make gcp-login) or service account key lives inside the containers.
GOOGLE_APPLICATION_CREDENTIALS=/gcp-adc/application_default_credentials.json
# Gemini model ID from Model Garden (publishers/google/models/ prefix optional). Empty = gemini-3.8-flash.
LLM_MODEL=
# Tokens Gemini may spend "thinking" before each reply. 0 = off (fastest, the default).
LLM_THINKING_BUDGET=0
# Fail fast instead of stalling: seconds to wait for one Gemini request, and retries after a failed one (e.g. 429).
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
# Cheaper model for answer verification (defaults to LLM_MODEL).
LLM_LIGHTWEIGHT_MODEL=

# Embeddings run locally (no API key). The guardrail, tool routing, Simple RAG and the seeded
# documents all use this model. If you change it, set EMBEDDING_DIM to match, then run
# `make generate-models` and `make setup`. Distance thresholds in the domain files were tuned for the default.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
REDIS_USERNAME=default
REDIS_DB=0
# Optional override. When unset, all domains use 0.3: this memory service scores natural-language
# matches low (a saved allergy only matches allergy questions at 0.3 or below; 0.5 matched nothing).
# MEMORY_SIMILARITY_THRESHOLD=0.3
MEMORY_LIMIT=6
LANGCACHE_THRESHOLD=0.9
# Semantic tool routing: send the LLM only the tools each question needs (saves tokens).
# Set to false to compare token usage with every tool attached.
TOOL_ROUTING_ENABLED=true
BACKEND_PORT=8040
FRONTEND_PORT=3040
